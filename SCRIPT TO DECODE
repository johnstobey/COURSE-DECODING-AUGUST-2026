        """Step 2: Identify the variant (checksum)."""
        # Perform frequency analysis
        word_freq = defaultdict(int)
        for word in self.analyzer.words:
            word_freq[word] += 1
        
        # Find outliers (words that appear significantly more or less than expected)
        avg_freq = sum(word_freq.values()) / len(word_freq)
        outliers = []
        for word, count in word_freq.items():
            if count > avg_freq * 2 or count < avg_freq * 0.5:
                outliers.append({"word": word, "count": count, "deviation": count - avg_freq})
        
        return {
            "frequency_analysis": {"total_unique_words": len(word_freq), "average_frequency": avg_freq},
            "outliers": outliers[:20],  # Top 20 outliers
            "checksum_candidates": outliers[:5],  # Top 5 as checksum candidates
            "note": "Checksum is derived from text itself, creating closed loop",
        }
    
    def matrix_mapping(self) -> Dict:
        """Step 3: Matrix mapping of text."""
        # Create a matrix representation
