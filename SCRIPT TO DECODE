class CipherMatrix:
    """Implements the Cayley subtraction table on Z/12 (Parts 49-55)."""
    
    def __init__(self):
        self.matrix = self._build_cayley_table()
        
    def _build_cayley_table(self) -> List[List[int]]:
        """Build the 12x12 Cayley subtraction table."""
        table = []
        for k in range(12):
            row = [(d - k) % 12 for d in range(12)]
            table.append(row)
        return table
    
    def transform(self, D: int, K: int) -> int:
        """Core cipher: C_n = (D_n - K_n) mod 12"""
        return self.matrix[K][D]
    
    def verify_latin_square(self) -> bool:
        """Verify that the matrix is a Latin square."""
        for row in self.matrix:
            if sorted(row) != list(range(12)):
                return False
        for col in range(12):
            column = [self.matrix[row][col] for row in range(12)]
            if sorted(column) != list(range(12)):
                return False
        return True
    
    def get_quadrant_output(self, D_reg: List[int], K_reg: List[int]) -> Dict:
        """Simulate the 4-quadrant cipher pipeline."""
        # Q1: Entry Transposition Grid
        normalized = [d % 12 for d in D_reg]
        
        # Q2: Modular Shifter Matrix
        shifted = [self.transform(normalized[i], K_reg[i] % 12) for i in range(min(len(normalized), len(K_reg)))]
        
        # Q3: Symmetrical Parity Filter
        parity_valid = all((s + k) % 2 == 0 for s, k in zip(shifted, K_reg[:len(shifted)]))
        
        # Q4: Cleartext Extraction Gate
        output_vector = shifted if parity_valid else []
        
        return {
            "Q1_input": normalized,
            "Q2_shifted": shifted,
            "Q3_parity_valid": parity_valid,
            "Q4_output": output_vector,
            "matrix_position": "SECURE" if parity_valid else "BREACH",
        }

