def h_n(longitude: float, n: int) -> float:
    """Harmonic longitude: H_n = (lon * n) mod 360"""
    return (longitude * n) % 360.0

def angular_sep(a: float, b: float) -> float:
    """Circular distance: Δ = min(|δ|, 360-|δ|)"""
    d = abs(a - b)
    return min(d, 360.0 - d)

def house_number(body_lon: float, asc_deg: float) -> int:
    """Equal house: floor((body - asc + 360) % 360 / 30) + 1"""
    offset = (body_lon - asc_deg) % 360.0
    return int(offset // 30.0) + 1

def cipher_value(body_lon: float, house_num: int) -> int:
    """Multiplicative cipher: (floor(lon) * house) mod 144"""
    return (int(math.floor(body_lon)) * house_num) % 144

def verify_lock_from_positions(pos0: Dict[str, float], pos3: Dict[str, float], lock_spec: Dict) -> Dict:
    """Recompute a single lock from two position dicts. Pure math, no ephemeris."""
    parts = lock_spec["pair"].split(" ↔ ")
    g0_name = parts[0].replace("G0 ", "").replace("-H9", "").replace("-H7", "")
    g3_name = parts[1].replace("G3 ", "").replace("-H9", "").replace("-H7", "")
    
    h0 = h_n(pos0[g0_name], lock_spec["harmonic"])
    h3 = h_n(pos3[g3_name], lock_spec["harmonic"])
    sep = angular_sep(h0, h3)
    
    return {
        "g0_body": g0_name, 
        "g3_body": g3_name,
        "harmonic": lock_spec["harmonic"],
        "g0_harmonic_deg": h0, 
        "g3_harmonic_deg": h3,
        "separation_deg": sep,
        "threshold_deg": lock_spec["threshold_deg"],
        "status": "PASS" if sep <= lock_spec["threshold_deg"] else "FAIL",
        "canonical_separation_deg": lock_spec["separation_deg"],
        "delta_from_canonical": sep - lock_spec["separation_deg"],
    }

